meta {
  name: Cambiar Estado
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/proveedores/{{proveedor_id_creado}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Origin: {{frontend_origin}}
  X-XSRF-TOKEN: {{xsrf_token}}
}

body:json {
  {
    "activo": true
  }
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 y activo=false", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().activo).to.equal(false);
  });
}

docs {
  Baja logica (nunca DELETE). Manda {"activo": true} para reactivar. Un
  proveedor inactivo no admite compras nuevas (422 en Compras > Crear
  Borrador).
}
