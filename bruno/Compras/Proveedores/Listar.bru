meta {
  name: Listar
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/proveedores
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: {{frontend_origin}}
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 y lista de proveedores", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().proveedores).to.be.an('array');
  });
}

docs {
  Filtro opcional ?activo=1 / ?activo=0. Requiere compra.registrar o
  config.modificar.
}
