meta {
  name: Listar
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/compras
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: {{frontend_origin}}
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 y lista de compras", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().compras).to.be.an('array');
  });
}

docs {
  Filtros opcionales: ?proveedor_id=, ?estatus=BORRADOR|PARCIAL|RECIBIDA|
  CANCELADA, ?sucursal_id=. Requiere compra.registrar.
}
