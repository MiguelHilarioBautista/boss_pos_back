meta {
  name: Logout
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/auth/logout
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: {{frontend_origin}}
  X-XSRF-TOKEN: {{xsrf_token}}
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("204 sin contenido", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Tras esto la sesion queda invalidada: cualquier request a Me/PIN/Cambiar
  contraseña debe volver 401 hasta que corras "0. Obtener CSRF Cookie" y
  "Login" de nuevo.
}
