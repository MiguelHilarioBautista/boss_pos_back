meta {
  name: Editar
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/sucursales/{{sucursal_id_creada}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Origin: {{frontend_origin}}
  X-XSRF-TOKEN: {{xsrf_token}}
}

body:json {
  {
    "nombre": "Sucursal Norte (renombrada)",
    "direccion": "Av. Siempre Viva 123",
    "telefono": "5555555555",
    "zona_frontera": false
  }
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  No admite cambiar "codigo" ni "activo" aqui — activo se maneja solo desde
  Cambiar Estado (queda auditado).
}
