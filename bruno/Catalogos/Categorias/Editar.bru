meta {
  name: Editar
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/categorias/{{categoria_id_creada}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Origin: {{frontend_origin}}
  X-XSRF-TOKEN: {{xsrf_token}}
}

body:json {
  {
    "nombre": "Bebidas y refrescos",
    "categoria_padre_id": null
  }
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Una categoria no puede ser su propio padre (422 si categoria_padre_id ==
  el id de esta misma categoria).
}
