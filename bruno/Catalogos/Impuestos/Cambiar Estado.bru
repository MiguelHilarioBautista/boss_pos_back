meta {
  name: Cambiar Estado
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/api/impuestos/{{impuesto_id_creado}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Origin: {{frontend_origin}}
  X-XSRF-TOKEN: {{xsrf_token}}
}

body:json {
  {
    "activo": false
  }
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 y activo=false", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().activo).to.equal(false);
  });
}

docs {
  Desactiva un impuesto vencido (p.ej. una tasa que ya no aplica) sin
  borrarlo — los productos historicos que lo usaron conservan la
  referencia. No confundir con editar la tasa: eso no existe (RN-M1-05).
}
