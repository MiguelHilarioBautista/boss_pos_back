meta {
  name: Historial de Precios
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/productos/{{producto_id_creado}}/historial-precios
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: {{frontend_origin}}
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Solo requiere sesion activa. Deberia traer el renglon que dejo
  "Editar (cambia precio)" con el usuario que lo hizo.
}
