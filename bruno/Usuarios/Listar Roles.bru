meta {
  name: Listar Roles
  type: http
  seq: 0
}

get {
  url: {{base_url}}/api/roles
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: {{frontend_origin}}
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Para pintar el selector de rol en "Añadir usuario": cada rol trae sus
  permisos ya fijos (RBAC por rol, no hay permisos por-usuario en este
  esquema). Usa el "id" de aquí como rol_id al crear un usuario.
}
