meta {
  name: Listar
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/usuarios
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: {{frontend_origin}}
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Requiere sesion activa (corre antes "0. Obtener CSRF Cookie" + "Login" en
  M0 — Auth) y permiso usuario.gestionar. Agrega ?solo_activos=1 para filtrar.
}
