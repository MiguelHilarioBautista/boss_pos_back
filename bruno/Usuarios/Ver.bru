meta {
  name: Ver
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/usuarios/{{usuario_id_creado}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: {{frontend_origin}}
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
  usuario_id_creado: 1
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Usa el id guardado por "Crear" (usuario_id_creado). Si no has corrido
  Crear en esta sesion, reemplaza {{usuario_id_creado}} por un id real.
}
