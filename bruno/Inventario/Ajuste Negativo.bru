meta {
  name: Ajuste Negativo
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/inventario/ajustes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Origin: {{frontend_origin}}
  X-XSRF-TOKEN: {{xsrf_token}}
}

body:json {
  {
    "producto_id": {{producto_id_creado}},
    "sucursal_id": {{sucursal_id_creada}},
    "tipo": "AJUSTE_NEGATIVO",
    "cantidad": 2,
    "motivo": "Merma por caducidad",
    "autorizado_por_id": {{autorizado_por_id}}
  }
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
  autorizado_por_id: 2
  producto_id_creado: 1
  sucursal_id_creada: 1
}

tests {
  test("201 o 409 segun stock disponible", function () {
    expect([201, 409]).to.include(res.getStatus());
  });
}

docs {
  Si pides mas de lo que hay disponible, responde 409 stock_insuficiente
  (rollback completo, no queda rastro en el kardex). Corre "Ajuste
  Positivo" primero para asegurar stock disponible.
}
