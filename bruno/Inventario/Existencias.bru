meta {
  name: Existencias
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/inventario
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: {{frontend_origin}}
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Filtros opcionales: ?sucursal_id=&producto_id=&bajo_minimo=1. Solo
  requiere sesion activa (CU-03).
}
