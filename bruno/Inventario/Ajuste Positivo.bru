meta {
  name: Ajuste Positivo
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/inventario/ajustes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Origin: {{frontend_origin}}
  X-XSRF-TOKEN: {{xsrf_token}}
}

body:json {
  {
    "producto_id": {{producto_id_creado}},
    "sucursal_id": {{sucursal_id_creada}},
    "tipo": "AJUSTE_POSITIVO",
    "cantidad": 10,
    "motivo": "Conteo inicial de existencias",
    "autorizado_por_id": {{autorizado_por_id}}
  }
}

vars:pre-request {
  base_url: http://127.0.0.1:8000
  frontend_origin: http://localhost:5173
  autorizado_por_id: 2
  producto_id_creado: 1
  sucursal_id_creada: 1
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar('movimiento_id_creado', res.getBody().movimiento.id);
  }
}

tests {
  test("201 creado", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  D-M2-4: autorizado_por_id es OBLIGATORIO y debe ser un usuario DISTINTO
  al que hace la peticion (el que esta logueado), activo, y con el permiso
  inventario.ajustar tambien — ajusta el valor por defecto (2) al id real
  de un segundo usuario en tu BD. costo_unitario es opcional: si lo omites,
  usa el costo_promedio actual (no altera el promedio, D-M2-3).
}
